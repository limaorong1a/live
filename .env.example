# 数据库（默认 SQLite，生产环境建议换 MySQL/PostgreSQL）
DATABASE_URL="file:./dev.db"

# 登录态签名密钥，生产环境务必改成随机长字符串（生产环境不改会拒绝启动）
# 可用命令生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string"

# 底层大模型 API Key（至少配置一个）
# DeepSeek 开放平台: https://platform.deepseek.com
DEEPSEEK_API_KEY=""
# 阿里云百炼（通义千问）: https://bailian.console.aliyun.com
DASHSCOPE_API_KEY=""

# （可选）覆盖模型接口地址，用于自建网关 / 本地联调
# DEEPSEEK_BASE_URL="https://api.deepseek.com/v1"
# DASHSCOPE_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"

# （可选）部署在自己可信的反向代理（如自建 Nginx）之后时设为 true，
# 才会信任 X-Forwarded-For 取真实客户端 IP 做限流。默认 false。
# TRUSTED_PROXY="false"

# （可选）账户页展示的客服联系方式
# NEXT_PUBLIC_SUPPORT_CONTACT="客服微信：skillrelay"

# （可选）站点公开域名，用于生成 sitemap 与分享链接
# NEXT_PUBLIC_SITE_URL="https://your-domain.com"
