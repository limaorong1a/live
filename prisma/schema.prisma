generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String       @id @default(cuid())
  email         String       @unique
  passwordHash  String
  credits       Int          @default(20)
  isAdmin       Boolean      @default(false)
  agreedAt      DateTime? // 同意用户协议/隐私政策的时间，合规留痕
  lastCheckInAt DateTime? // 上次签到时间（按自然日判重）
  streak        Int          @default(0) // 连续签到天数
  maxStreak     Int          @default(0)
  inviteCode    String?      @unique // 我的邀请码
  invitedById   String? // 邀请我的人的 userId
  firstRunRewarded Boolean   @default(false) // 是否已因首次运行发放邀请奖励
  invitedCount  Int          @default(0) // 我成功邀请并激活的人数
  createdAt     DateTime     @default(now())
  runs          Run[]
  redeemCodes   RedeemCode[]
  createdSkills Skill[]      @relation("createdSkills")
}

model RedeemCode {
  id        String    @id @default(cuid())
  code      String    @unique
  credits   Int
  usedBy    User?     @relation(fields: [usedById], references: [id])
  usedById  String?
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model Skill {
  id             String   @id @default(cuid())
  slug           String   @unique
  name           String
  description    String
  category       String
  emoji          String   @default("✨")
  inputs         String // JSON: 输入字段定义数组
  systemPrompt   String
  promptTemplate String // 使用 {{key}} 占位符
  costCredits    Int      @default(1)
  model          String   @default("deepseek-chat")
  published      Boolean  @default(true)
  reviewStatus   String   @default("approved") // pending | approved | rejected
  creator        User?    @relation("createdSkills", fields: [creatorId], references: [id])
  creatorId      String?
  runsCount      Int      @default(0)
  createdAt      DateTime @default(now())
  runs           Run[]
}

model Run {
  id           String   @id @default(cuid())
  user         User     @relation(fields: [userId], references: [id])
  userId       String
  skill        Skill    @relation(fields: [skillId], references: [id])
  skillId      String
  inputs       String // JSON: 用户提交的输入
  output       String   @default("")
  creditsSpent Int
  status       String   @default("running") // running | done | error | blocked
  refineCount  Int      @default(0) // 已追问/改写次数（前若干次免费）
  ip           String?
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
}

// 充值订单：支持可插拔支付网关（人工确认 / 微信 / 支付宝）
model Order {
  id         String    @id @default(cuid())
  userId     String
  credits    Int // 购买的积分数
  amountFen  Int // 金额（单位：分）
  status     String    @default("pending") // pending | paid | canceled
  provider   String    @default("manual") // manual | wechat | alipay
  outTradeNo String    @unique // 商户订单号
  paidAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

// 合规审计日志：登录/注册/兑换/管理操作留痕，含 IP，便于溯源与投诉处理
model AuditLog {
  id        String   @id @default(cuid())
  type      String // login | login_fail | register | redeem | admin_adjust
  userId    String?
  ip        String?
  detail    String   @default("")
  createdAt DateTime @default(now())

  @@index([type, createdAt])
}
